{
  "name": "@repo/seed-http",
  "version": "0.0.2",
  "private": true,
  "description": "The HTTP seeder: creates a SeedSpec as a real plan through the public REST API (ADR-0066). Authenticates, obeys RBAC and holds the plan edit-lock like any other client; never touches a database.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@repo/seed": "workspace:*"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "^22.10.7",
    "eslint": "^9.39.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
