# =============================================================================
# Blank App — environment variable template
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.
# For production, provide these via your secrets manager, not a file.
# See docs/DEPLOYMENT.md and SECURITY.md.
# -----------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development

# --- Database (PostgreSQL / Prisma) -----------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public

# Values used by docker-compose to provision the local Postgres container.
# `app` is for local development only. A deployment should set a real password; the API logs a
# warning at start-up while it is still `app`. Steps: docs/guides/back-up-and-restore.md,
# "Set a database password".
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- API (NestJS) ------------------------------------------------------------
API_PORT=3000
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173
# Log level: fatal | error | warn | info | debug | trace | silent (default info).
LOG_LEVEL=info
# Rate limiting: window in seconds and max requests per window.
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# --- Authentication (Better Auth) -------------------------------------------
# Generate a strong random secret, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-in-every-environment
BETTER_AUTH_URL=http://localhost:3000
# Require a verified email before an account is usable AND before an invitation
# can be accepted — the single switch that makes the invitation-accept email
# check a real proof of mailbox ownership (ADR-0016 §5, docs/TECH_DEBT.md #16).
# The verification email IS now sent; off by default because turning it on needs
# a mail transport. In production the API refuses to boot with this "true" and no
# MAIL_SMTP_URL, because the stub only writes the link to the server log.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Transactional email. Unset = the logging stub (mail is logged, not sent), which
# is the default. Set both to send for real; the API refuses to boot in production
# with AUTH_REQUIRE_EMAIL_VERIFICATION=true and no MAIL_SMTP_URL. Quote MAIL_FROM —
# the angle brackets are shell redirection if this file is ever sourced.
MAIL_SMTP_URL=
MAIL_FROM="SchedulePoint <no-reply@example.com>"
# Where to POST when mail stops working (ntfy, a Slack/Discord webhook, anything
# that accepts a JSON POST). Unset = today's behaviour exactly: the failure is
# logged and nothing else. The message names counts, the window and which kind of
# message failed — NEVER a recipient address, because this leaves the system.
# MAIL_ALERT_WINDOW_MINUTES bounds the repeats, not the first alert: a broken
# relay fails every send, and forty-three copies of "a send failed" is how an
# alert channel gets muted.
MAIL_ALERT_URL=
MAIL_ALERT_WINDOW_MINUTES=10
# Dead-man's-switch. The API POSTs here on an interval so an external service can
# alert on the ABSENCE of the ping — the one honest thing an app can do about its
# own liveness, since it cannot report that it is down. Unset = no timer at all.
# Point it at a healthchecks.io check (or similar) and set that check's period a
# little longer than the interval below.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_MINUTES=5

# --- Retention (ADR-0087) -----------------------------------------------------
# Deletes rows past their documented period, on a timer inside the API process.
# ON by default: unlike the two alerting URLs above, a sweep needs no external
# receiver, and its periods were already decided by an accepted ADR.
#
# SHORTENING A PERIOD IS FREE; LENGTHENING IT RECOVERS NOTHING. Rows deleted
# under the old value are gone. The effective values are logged at boot
# (`retention.configured`) and shown on the staff console.
RETENTION_SWEEP_ENABLED=true
RETENTION_CSP_REPORTS_DAYS=30
RETENTION_MAIL_EVENTS_DAYS=365
# Canvas performance-probe readings taken from the staff console. Same 365 as mail events, on
# purpose: the class of data is the same (a staff member's own machine and address), and two periods
# for one class is a question nobody can answer later. A year is also what makes the table useful --
# the point is comparing a machine against itself across releases.
RETENTION_PERF_PROBE_DAYS=365
# Browser crash reports, counted from the crash's LAST report: one still happening never expires.
# Optional -- 30 is the default and nothing needs setting.
# RETENTION_CRASH_REPORTS_DAYS=30

# Days a deleted client/project/plan is kept in Recently deleted before it is PERMANENTLY removed
# (ADR-0096). The clock counts from the deletion, not from when this was set, so raising it on an
# existing host reprieves everything currently in the bin and lowering it brings expiries forward.
# Served to the app so the countdown on screen is this number and never a hardcoded one.
RETENTION_HIERARCHY_DAYS=90
# Whether that sweep actually DELETES. Off by default and separate from RETENTION_SWEEP_ENABLED on
# purpose. See what would go before anything does with
# `docker compose exec api node dist/cli/clear-out-preview.js` (ADR-0193): the countdown on screen
# is not shown while this is off, so it is not a preview.
RETENTION_HIERARCHY_ENABLED=false
RETENTION_SWEEP_INTERVAL_MINUTES=60
# SchedulePoint staff console (ADR-0086). Comma-separated addresses that may reach
# /api/v1/staff/*. Empty = nobody. Staff operate the INSTALLATION — mail health, CSP
# reports, version state — and can reach no customer data at all: StaffPrincipal has no
# memberships and no can(), so a staff request reaching a member service is a compile
# error. An allowlisted address must also have a verified email, unconditionally.
STAFF_EMAILS=
# Comma-separated proxy IPs/CIDRs in front of the API (outermost→innermost).
# The auth rate limiter derives the client IP from X-Forwarded-For; listing the
# trusted proxies stops that header being spoofed to bypass the limit. REQUIRED
# in production (the app refuses to boot without it); leave empty in local dev.
TRUSTED_PROXY_IPS=

# --- Plan edit-lock (ADR-0028) ----------------------------------------------
# When "true", structural plan writes (activity/dependency create/update/delete,
# positions batch, schedule recalculate) require the caller to hold the plan
# edit-lock and return 423 otherwise. Server-side enforcement is OFF by default
# and is the single deliberate rollout switch: the web pen is always on, so users
# already acquire the pen on every editing entry point. Enable enforcement only
# AFTER a web bundle that carries the pen is deployed (ADR-0028 §9 ordering) —
# flipping it ahead of the web bundle would 423 those flows.
# The progress path and reads are never gated regardless of this flag.
PLAN_EDIT_LOCK_ENFORCED=false

# --- Web container: Content-Security-Policy (ADR-0074, TECH_DEBT #8) ---------
# NOT a VITE_ variable and deliberately so: these are read by nginx at CONTAINER
# START, not baked into the bundle, which is what makes flipping to enforce — or
# rolling back from it — an env change rather than a new image through the
# release train. A rollback that needs a release is slower than the incident.
#
# Report-only is the default: a deployment observes before it enforces. Violations
# go to the browser console (no report-to sink is configured — that would be a new
# public endpoint; see ADR-0074 §4). To enforce, set the name to the enforcing
# header. Leave both blank to take the image defaults.
#
#   CSP_HEADER_NAME=Content-Security-Policy-Report-Only   # observe (default)
#   CSP_HEADER_NAME=Content-Security-Policy               # enforce
CSP_HEADER_NAME=
# Override only if a report-only window found something the derived policy misses.
# If styles turn out to need it, relax `style-src` ONLY — never `script-src`.
CSP_POLICY=

# --- Web (Vite) --------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to the client bundle.
#
# ### READ THIS BEFORE BELIEVING A "rollback / opt-out" NOTE BELOW
#
# **The VITE_ feature flags below are NOT operator switches, and setting one here does
# nothing to a deployed container.** Vite inlines `import.meta.env.VITE_*` as a literal at
# BUILD time, so a flag's value is baked into the JavaScript when the image is built —
# there is no runtime lookup left in the bundle to override.
#
# And no build path sets them. `apps/web/Dockerfile` declares exactly ONE VITE_ build arg
# (`VITE_API_URL`); `.github/workflows/docker-publish.yml` — which builds every image you
# pull — passes no build args at all; and `.dockerignore` excludes `**/.env` from the build
# context, so a value written here never reaches the daemon in the first place. Every
# published image therefore has every flag at its in-source default, which is ON.
#
# **Your rollback is pinning the previous image tag**, not a flag. `web` and `api` are
# versioned and published separately (ADR-0027), so `WEB_IMAGE_TAG=…:0.81.0` in
# `docker-compose.release.yml` rolls the client back without touching the API or the
# schema — and Watchtower (ADR-0047) only acts when `:latest` moves, so a pinned tag holds
# rather than being silently re-pulled. See `docs/DEPLOYMENT.md`.
#
# The switches on THIS file that genuinely work at container start are the server-side
# ones above and below — `RETENTION_SWEEP_ENABLED`, `PLAN_EDIT_LOCK_ENFORCED`,
# `AUTH_REQUIRE_EMAIL_VERIFICATION`, `STAFF_EMAILS`, `MAIL_ALERT_URL`, `CSP_*`. They read
# `process.env` at boot, which is exactly the property the CSP block 30 lines up prizes:
# "a rollback that needs a release is slower than the incident."
#
# The per-flag "Set to false to fall back to…" notes below are DEVELOPMENT and CI
# instructions — `pnpm dev`, a local `pnpm build`, and the flag-off Playwright configs use
# them, and they work there. They have never worked against a published image, and the
# notes read as operator guidance because nobody had checked. Left in place rather than
# deleted because they are true of the surface they describe; scoped by this banner
# instead.
VITE_API_URL=http://localhost:3000
# (VITE_CANVAS_WORKSPACE was here until ADR-0088 D3. The canvas-first plan workspace (ADR-0030) is
# now the only plan surface there is: the flag is retired and the legacy long stacked plan-detail
# page it selected is deleted, so there is nothing left to set. It was the estate's LAST Class A
# flag — every flag that remains is a one-line guard, not a second implementation.)
# (VITE_CANVAS_TOOLBAR was here until ADR-0088 D3. The canvas-maximal toolbar architecture
# (ADR-0031) is now the only plan workspace there is: the flag is retired and the ADR-0030 layout
# it selected is deleted, so there is nothing left to set.)
# VITE_SCHEDULING_MODES is GONE (one-planning-surface M-F, 2026-09-20). It gated ADR-0033's
# plan-level Early/Visual scheduling mode; there is one planning surface now, so a bar is always
# drawn where it is placed and there is nothing left to switch. The three things it also gated are
# still here and still on — the read-only Late-Start overlay, the display-only "Go to date" control
# and the Visual-conflict legend key — because none of them ever read the mode. Setting this key
# does nothing; it is tombstoned rather than deleted so an operator who copied an older file gets
# an explanation rather than silence.
# (VITE_LIBRARY_SCOPING was here until ADR-0088 D3. The library scoping & manageability
# surface (ADR-0053) is now the only one there is: the flag is retired and the raw-`<select>`
# pickers it selected are deleted, so there is nothing left to set.)

# --- Self-hosted RELEASE stack (docker-compose.release.yml) — NOT app config ---
# These are consumed only by the release stack on a self-hosted host, not by the
# app at runtime. See docs/DEPLOYMENT.md. Leave unset for the compose defaults.
#
# Image tag per app (each defaults to `latest`; the two version independently — ADR-0027).
# Pin a version to roll back or hold a known release; `latest` tracks the newest.
# WEB_IMAGE_TAG=latest                  # or a version like 0.31.0
# API_IMAGE_TAG=latest                  # or a version like 0.18.0
# IMAGE_TAG=latest                      # shared override for BOTH (e.g. a branch build: main / sha-<short>)
#
# Optional automatic redeploy via Watchtower (ADR-0047), enabled only when the
# `autodeploy` compose profile is active:
#   COMPOSE_PROFILES=autodeploy docker compose -f docker-compose.release.yml up -d
# WATCHTOWER_POLL_INTERVAL=300          # seconds between GHCR checks
# WATCHTOWER_MONITOR_ONLY=false         # true = notify only, don't auto-update (a manual gate)
# WATCHTOWER_NOTIFICATION_URL=          # optional shoutrrr URL for release notifications
# DOCKER_CONFIG_DIR=/root/.docker       # ABSOLUTE path to the dir holding the `docker login ghcr.io` config.json (no ~)
#
# Database backups (ADR-0192; the guide is docs/guides/back-up-and-restore.md). Both names are part of
# the 1.0 promise. The release stack's `backup` service writes one copy a night to BACKUP_DIR and the
# api writes one there before an update that changes the database. The folder must exist and belong to
# uid 1000 BEFORE the stack starts:  sudo install -d -o 1000 -g 1000 -m 700 backups
# BACKUP_DIR=./backups                  # HOST folder for the copies, relative to the compose file
# BACKUP_KEEP_DAYS=30                   # whole days 1-3650; older copies are deleted after a good one
