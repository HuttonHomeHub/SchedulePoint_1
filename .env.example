# =============================================================================
# Blank App — environment variable template
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.
# For production, provide these via your secrets manager, not a file.
# See docs/DEPLOYMENT.md and SECURITY.md.
# -----------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development

# --- Database (PostgreSQL / Prisma) -----------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://app:app@localhost:5432/app?schema=public

# Values used by docker-compose to provision the local Postgres container.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- API (NestJS) ------------------------------------------------------------
API_PORT=3000
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173
# Log level: fatal | error | warn | info | debug | trace | silent (default info).
LOG_LEVEL=info
# Rate limiting: window in seconds and max requests per window.
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# --- Authentication (Better Auth) -------------------------------------------
# Generate a strong random secret, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-in-every-environment
BETTER_AUTH_URL=http://localhost:3000
# Require a verified email before an account is usable AND before an invitation
# can be accepted — the single switch that makes the invitation-accept email
# check a real proof of mailbox ownership (ADR-0016 §5, docs/TECH_DEBT.md #16).
# The verification email IS now sent; off by default because turning it on needs
# a mail transport. In production the API refuses to boot with this "true" and no
# MAIL_SMTP_URL, because the stub only writes the link to the server log.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Transactional email. Unset = the logging stub (mail is logged, not sent), which
# is the default. Set both to send for real; the API refuses to boot in production
# with AUTH_REQUIRE_EMAIL_VERIFICATION=true and no MAIL_SMTP_URL. Quote MAIL_FROM —
# the angle brackets are shell redirection if this file is ever sourced.
MAIL_SMTP_URL=
MAIL_FROM="SchedulePoint <no-reply@example.com>"
# Where to POST when mail stops working (ntfy, a Slack/Discord webhook, anything
# that accepts a JSON POST). Unset = today's behaviour exactly: the failure is
# logged and nothing else. The message names counts, the window and which kind of
# message failed — NEVER a recipient address, because this leaves the system.
# MAIL_ALERT_WINDOW_MINUTES bounds the repeats, not the first alert: a broken
# relay fails every send, and forty-three copies of "a send failed" is how an
# alert channel gets muted.
MAIL_ALERT_URL=
MAIL_ALERT_WINDOW_MINUTES=10
# Dead-man's-switch. The API POSTs here on an interval so an external service can
# alert on the ABSENCE of the ping — the one honest thing an app can do about its
# own liveness, since it cannot report that it is down. Unset = no timer at all.
# Point it at a healthchecks.io check (or similar) and set that check's period a
# little longer than the interval below.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_MINUTES=5

# --- Retention (ADR-0087) -----------------------------------------------------
# Deletes rows past their documented period, on a timer inside the API process.
# ON by default: unlike the two alerting URLs above, a sweep needs no external
# receiver, and its periods were already decided by an accepted ADR.
#
# SHORTENING A PERIOD IS FREE; LENGTHENING IT RECOVERS NOTHING. Rows deleted
# under the old value are gone. The effective values are logged at boot
# (`retention.configured`) and shown on the staff console.
RETENTION_SWEEP_ENABLED=true
RETENTION_CSP_REPORTS_DAYS=30
RETENTION_MAIL_EVENTS_DAYS=365

# Days a deleted client/project/plan is kept in Recently deleted before it is PERMANENTLY removed
# (ADR-0096). The clock counts from the deletion, not from when this was set, so raising it on an
# existing host reprieves everything currently in the bin and lowering it brings expiries forward.
# Served to the app so the countdown on screen is this number and never a hardcoded one.
RETENTION_HIERARCHY_DAYS=90
# Whether that sweep actually DELETES. Off by default and separate from RETENTION_SWEEP_ENABLED on
# purpose: the countdown ships one release ahead of the deletion, so an operator can see what would
# go before anything does.
RETENTION_HIERARCHY_ENABLED=false
RETENTION_SWEEP_INTERVAL_MINUTES=60
# SchedulePoint staff console (ADR-0086). Comma-separated addresses that may reach
# /api/v1/staff/*. Empty = nobody. Staff operate the INSTALLATION — mail health, CSP
# reports, version state — and can reach no customer data at all: StaffPrincipal has no
# memberships and no can(), so a staff request reaching a member service is a compile
# error. An allowlisted address must also have a verified email, unconditionally.
STAFF_EMAILS=
# Comma-separated proxy IPs/CIDRs in front of the API (outermost→innermost).
# The auth rate limiter derives the client IP from X-Forwarded-For; listing the
# trusted proxies stops that header being spoofed to bypass the limit. REQUIRED
# in production (the app refuses to boot without it); leave empty in local dev.
TRUSTED_PROXY_IPS=

# --- Plan edit-lock (ADR-0028) ----------------------------------------------
# When "true", structural plan writes (activity/dependency create/update/delete,
# positions batch, schedule recalculate) require the caller to hold the plan
# edit-lock and return 423 otherwise. Server-side enforcement is OFF by default
# and is the single deliberate rollout switch: the web pen (VITE_PLAN_EDIT_LOCK,
# below) now defaults ON, so users already acquire the pen on every editing entry
# point. Enable enforcement only AFTER a bundle with the pen on is deployed
# (ADR-0028 §9 ordering) — flipping it ahead of the web bundle would 423 those
# flows. The progress path and reads are never gated regardless of this flag.
PLAN_EDIT_LOCK_ENFORCED=false

# --- Web container: Content-Security-Policy (ADR-0074, TECH_DEBT #8) ---------
# NOT a VITE_ variable and deliberately so: these are read by nginx at CONTAINER
# START, not baked into the bundle, which is what makes flipping to enforce — or
# rolling back from it — an env change rather than a new image through the
# release train. A rollback that needs a release is slower than the incident.
#
# Report-only is the default: a deployment observes before it enforces. Violations
# go to the browser console (no report-to sink is configured — that would be a new
# public endpoint; see ADR-0074 §4). To enforce, set the name to the enforcing
# header. Leave both blank to take the image defaults.
#
#   CSP_HEADER_NAME=Content-Security-Policy-Report-Only   # observe (default)
#   CSP_HEADER_NAME=Content-Security-Policy               # enforce
CSP_HEADER_NAME=
# Override only if a report-only window found something the derived policy misses.
# If styles turn out to need it, relax `style-src` ONLY — never `script-src`.
CSP_POLICY=

# --- Web (Vite) --------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to the client bundle.
#
# ### READ THIS BEFORE BELIEVING A "rollback / opt-out" NOTE BELOW
#
# **The VITE_ feature flags below are NOT operator switches, and setting one here does
# nothing to a deployed container.** Vite inlines `import.meta.env.VITE_*` as a literal at
# BUILD time, so a flag's value is baked into the JavaScript when the image is built —
# there is no runtime lookup left in the bundle to override.
#
# And no build path sets them. `apps/web/Dockerfile` declares exactly ONE VITE_ build arg
# (`VITE_API_URL`); `.github/workflows/docker-publish.yml` — which builds every image you
# pull — passes no build args at all; and `.dockerignore` excludes `**/.env` from the build
# context, so a value written here never reaches the daemon in the first place. Every
# published image therefore has every flag at its in-source default, which is ON.
#
# **Your rollback is pinning the previous image tag**, not a flag. `web` and `api` are
# versioned and published separately (ADR-0027), so `WEB_IMAGE_TAG=…:0.81.0` in
# `docker-compose.release.yml` rolls the client back without touching the API or the
# schema — and Watchtower (ADR-0047) only acts when `:latest` moves, so a pinned tag holds
# rather than being silently re-pulled. See `docs/DEPLOYMENT.md`.
#
# The switches on THIS file that genuinely work at container start are the server-side
# ones above and below — `RETENTION_SWEEP_ENABLED`, `PLAN_EDIT_LOCK_ENFORCED`,
# `AUTH_REQUIRE_EMAIL_VERIFICATION`, `STAFF_EMAILS`, `MAIL_ALERT_URL`, `CSP_*`. They read
# `process.env` at boot, which is exactly the property the CSP block 30 lines up prizes:
# "a rollback that needs a release is slower than the incident."
#
# The per-flag "Set to false to fall back to…" notes below are DEVELOPMENT and CI
# instructions — `pnpm dev`, a local `pnpm build`, and the flag-off Playwright configs use
# them, and they work there. They have never worked against a published image, and the
# notes read as operator guidance because nobody had checked. Left in place rather than
# deleted because they are true of the surface they describe; scoped by this banner
# instead.
VITE_API_URL=http://localhost:3000
# On-canvas TSLD structural editing (M2, ADR-0026). ON by default (2026-07-12) —
# create/move/link on the logic diagram is live. Set to "false" to fall back to
# the read-only M1 surface (rollback / opt-out). Leave blank to use the default.
VITE_TSLD_EDITING=
# Plan edit-lock "pen" web layer (ADR-0028). ON by default (2026-07-12): a Planner
# takes an exclusive lock ("Start editing") before the schedule-editing affordances
# go live, and peers see who holds it. Set to "false" to ship it inert (role-only
# gating, no lock polling). Keep this ON before enabling PLAN_EDIT_LOCK_ENFORCED.
VITE_PLAN_EDIT_LOCK=
# (VITE_CANVAS_WORKSPACE was here until ADR-0088 D3. The canvas-first plan workspace (ADR-0030) is
# now the only plan surface there is: the flag is retired and the legacy long stacked plan-detail
# page it selected is deleted, so there is nothing left to set. It was the estate's LAST Class A
# flag — every flag that remains is a one-line guard, not a second implementation.)
# (VITE_CANVAS_TOOLBAR was here until ADR-0088 D3. The canvas-maximal toolbar architecture
# (ADR-0031) is now the only plan workspace there is: the flag is retired and the ADR-0030 layout
# it selected is deleted, so there is nothing left to set.)
# Canvas-first plan authoring (ADR-0032) on the plan workspace: draw the first activity
# on a blank canvas, inline timeline start-date, auto-recalc after edits, on-canvas activity types
# (task + milestones), two-click Link tool. ON by default (M1–M5 shipped, gates green). This said
# "Requires the workspace flag (default-on); turning it off disables authoring too" until
# 2026-08-17 — there is no workspace flag any more (ADR-0088 D3, tombstoned above), so there was
# nothing left to require. Set to "false" to roll back to table-first authoring + edge-drag
# linking. Leave blank for the default (on).
VITE_CANVAS_AUTHORING=
# Scheduling modes & de-overloaded plan start (ADR-0033), layered on the canvas authoring host:
# plan-level Early/Visual scheduling mode + a read-only Late-Start overlay, a display-only "Go to
# date" control split out from the project start, and Visual Planning (dragging a bar records an
# advisory visualStart that pushes successors and flags conflicts). ON by default (M5 enablement).
# The mandatory project start (M1) is live independent of this flag. Requires the authoring host
# (default-on); turning it off disables scheduling modes too. Set to "false" to roll back to the
# single-mode canvas. Leave blank for the default (on).
VITE_SCHEDULING_MODES=
# Progress ingestion controls (ADR-0035, M2). Adds a remaining-duration input plus suspend/resume
# dates to the progress editor, and a plan-level recalc-mode picker (Retained Logic / Progress
# Override / Actual Dates). The engine ingests actuals and honours the plan's stored recalc mode
# regardless of this flag; the flag only governs whether a planner can edit the new fields in the
# web UI (percent + actual dates were always editable). ON by default — set to "false" to roll back
# to the percent-plus-actual-dates editor.
VITE_PROGRESS_INGESTION=
# Client-side undo/redo for plan authoring (ADR-0048). ON by default (2026-07-19, gates green):
# toolbar Undo/Redo + Cmd/Ctrl+Z keys replay plan INPUTS through the existing mutation hooks (behind
# the pen, never engine-owned derived columns) and the normal auto-recalc redraws; a bounded, per-plan,
# per-pen-session stack. Set to "false" to ship it inert (no store/keys, placeholder toolbar items),
# byte-for-byte the prior behaviour (rollback / opt-out). Leave blank for the default (on).
VITE_UNDO_REDO=
# TSLD toolbar quick-wins (docs/specs/toolbar-quick-wins/). OFF by default during build — flips on
# after the specialist reviews are green (M3). Wires five previously-"Coming soon" TSLD toolbar
# buttons (Recenter-on-today, Comments, Update-progress, Add-note, Clear-visual-placement) to
# already-shipped features; no API/schema/engine change. Set to "true" to enable it; blank/"false"
# keeps the placeholders, byte-for-byte the current toolbar.
VITE_TOOLBAR_QUICK_WINS=
# TSLD canvas insight lenses (docs/specs/canvas-lenses/). OFF by default during build — flips on
# after the specialist reviews are green (M4). Turns three shaded Look-row toolbar placeholders into
# real client-side read lenses: filter/search (dim non-matches), Colour by… (Criticality / Total-float
# bucket / WBS group), and a baseline ghost overlay — all over already-shipped data, no API/schema/
# engine change. Set to "true" to enable it; blank/"false" keeps the placeholders and today's canvas
# paint, byte-for-byte.
VITE_CANVAS_LENSES=
# TSLD canvas navigation & authoring aids (docs/specs/canvas-nav/). OFF by default during build —
# flips on after the specialist reviews are green (M4). Turns three toolbar placeholders into real
# client-side commands over already-shipped data: Isolate logic path (dim everything off the selected
# activity's predecessor/successor chain — full or driving-only), Next conflict (cycle the plan's
# flagged activities, each centred + selected + announced), and Snap to grid (round a Visual-mode drop
# to the nearest working day before the existing PATCH). No API/schema/engine change. Set to "true" to
# enable it; blank/"false" keeps the placeholders, today's canvas paint and a11y tree, byte-for-byte.
VITE_CANVAS_NAV=
# TSLD export & print (docs/specs/export-print/, Stage C1). OFF by default during build — flips on
# after the specialist reviews are green (M5). Turns the two "Coming soon" toolbar placeholders
# (export, print) into real client-side deliverables: Schedule (CSV, Excel-safe + injection-safe),
# Diagram (PNG/PDF, off-screen render of the whole diagram) and a Browser Print — all over
# already-shipped data + the shipped canvas renderer, no API/schema/engine change. Set to "true" to
# enable it; blank/"false" keeps the placeholders, byte-for-byte the current toolbar.
VITE_EXPORT_PRINT=
# On-canvas advanced activity types (docs/specs/canvas-activity-types/, Stage D). OFF by default during
# build — flips on after the specialist reviews are green (Task 4). Collapses the Add split-button's two
# disabled "Soon" placeholders (Level of effort + Hammock) into ONE live "Level of Effort (hammock)" item
# that arms a canvas endpoint-pick tool: pick a start driver, then a finish driver, and SchedulePoint
# composes a Level-of-Effort activity + its SS/FF edges as one undoable action, then recalcs + redraws.
# Frontend-only over the already-shipped LOE engine/API — no API/schema/engine change (a raw HAMMOCK
# create is never wired). Set to "true" to enable it; blank/"false" keeps today's "Soon" items byte-for-byte.
VITE_CANVAS_ACTIVITY_TYPES=
# TSLD canvas-axis-aligned resource strip (docs/specs/canvas-resource-view/, Stage E; ADR-0049). OFF by
# default during build — flips on after the specialist reviews are green (Task 6). Turns the
# `resource-view` Look-row toolbar placeholder into a real lens: a demand strip pinned to the TSLD time
# axis — a Canvas 2D sibling layer (bars) painted by the existing canvas loop from the same viewport, so
# the per-bucket bars sit under the diagram's day/week/month columns and pan/zoom with the canvas — plus
# a DOM ResourceStripPanel with a resource picker, the reused bucket-size Select, and the reused
# accessible data table. Reads the already-shipped resource-histogram read-model; frontend-only, no
# API/schema/engine change. Gated on VITE_RESOURCE_CURVES (no data → the placeholder stays). Set to
# "true" to enable it; blank/"false" keeps the placeholder and today's canvas paint, byte-for-byte.
VITE_CANVAS_RESOURCE_VIEW=
# Schedule interchange web review UI (docs/specs/schedule-interchange/, Stage C2 M1; ADR-0050). OFF by
# default during build — flips on after the specialist reviews (a11y / ux / component / security) are
# green (the M1 review-gate step). Turns the project plan-create surface's "Import from file…" entry +
# the dry-run review dialog (report table, approximation/repair/drop lists, download) + commit →
# open-plan on, over the already-shipped @repo/interchange pipeline + the interchange dry-run/commit
# endpoints. Additionally gated on the caller holding interchange:import (Planner + Org Admin). Set to
# "true" to enable it; blank/"false" keeps the plan-create surface byte-for-byte today's (no entry).
VITE_SCHEDULE_INTERCHANGE=
# External-Guest per-plan share links web surface (docs/specs/external-guest-share-link/, Stage F M4;
# ADR-0051). ON by default (2026-07-21) now the specialist reviews (component / ux / a11y / performance /
# security) + the flag-on Playwright journey are green. Turns on BOTH the member Share dialog (the TSLD
# toolbar's "share" item lists / creates / revokes a plan's links + shows the one-time guest URL, gated on
# the caller holding plan:share — Planner + Org Admin) AND the public read-only /share guest view (a
# sibling of the app-shell, no session, token read from the URL fragment), over the already-shipped F-M2
# management + F-M3 guest-read endpoints. Set to "false" for a byte-for-byte rollback: the toolbar "share"
# placeholder stays and no /share route is registered. Leave blank to use the default.
VITE_GUEST_SHARE_LINKS=
# Live cross-plan / programme scheduling web surface (inter-project M2, ADR-0045). ON by default now
# its component / ux / a11y / e2e gates are green: the activity panel's cross-plan links section, the
# Recalculate-programme control (result / 423-locked / 422-too-large handling) and the staleness
# banner. The surface stays invisible for an ordinary plan (it appears only for a plan with live
# cross-plan links). Set to "false" for a byte-for-byte rollback. Leave blank to use the default.
VITE_PROGRAMME_SCHEDULING=
# TSLD canvas direct manipulation + visual refresh (docs/specs/canvas-direct-manipulation/,
# ADR-0052). ON by default (2026-07-25) now M1–M5 have landed with the specialist reviews + the
# draw-budget benchmark green: dependency links anchor at the working-day point their lag
# constrains (lead = left; TWENTY_FOUR_HOUR lag = elapsed days) with directional arrowheads, the
# bar ends become duration-resize handles (mode-aware start edge) with a draggable lag anchor, and
# the bars + links get the token-resolved visual refresh. Set to "false" for a byte-for-byte
# rollback to the legacy edge-drag zones and canvas paint. Leave blank to use the default.
VITE_CANVAS_DIRECT_MANIPULATION=

# (VITE_LIBRARY_SCOPING was here until ADR-0088 D3. The library scoping & manageability
# surface (ADR-0053) is now the only one there is: the flag is retired and the raw-`<select>`
# pickers it selected are deleted, so there is nothing left to set.)

# Designed chrome band (ADR-0055, docs/specs/designed-ui/). DEFAULT ON since 2026-07-26, after
# the S5 enablement gate (specialist reviews folded, four-theme axe run). When on, the header row and — on a plan — the two toolbar rows render as ONE full-bleed
# band across the top (navy in Corporate, neutral in Light/Dark), with the Project Explorer and
# the workspace below it; the toolbar reaches the band through a portal, so no plan state moves
# into the shell. It also stamps `data-designed-chrome` on <html>, which activates the flagged
# token values (S3's light Corporate rail) — so the rollback is byte-for-byte for colour as well
# as structure. Route bodies keep their measure cap: chrome is full-bleed, content is not.
# Frontend-only. Set to "false" for a byte-for-byte rollback to the pre-epic shell.
VITE_DESIGNED_CHROME=

# Canvas visual language (ADR-0055 §4, docs/specs/designed-ui/). DEFAULT ON since 2026-07-26,
# after the S5 draw-budget measurement (the band pass sits inside the baseline's own run-to-run
# spread at 2,000 activities — see the plan's S5-T2 for method and hardware). When on, the TSLD diagram sits on a ground of its own with alternating month
# bands, so a planner can count months without reading a label. Banding is ground, not a gridline,
# so it does not follow the Month-grid toggle; its parity is the absolute month ordinal, so the
# stripes cannot invert when the viewport pans. Costs one fillStyle + at most visibleMonths+1
# fillRect per frame and no text. Frontend-only. Set to "false" for a byte-for-byte paint.
VITE_CANVAS_VISUAL_LANGUAGE=

# TSLD time-axis legibility (ADR-0056, docs/specs/tsld-toolbar-canvas-refinements/). DEFAULT ON
# (since M7) — range-anchored zoom presets, tiered gridlines, an interpolated Today marker + pill,
# and ground-vs-non-working shading. Frontend-only. Set to "false" for a byte-for-byte rollback.
VITE_CANVAS_TIME_AXIS=

# Gantt view (ADR-0059, docs/specs/gantt-view/). DEFAULT ON since 2026-07-28 (M6).
# The plan workspace carries a TSLD | Gantt view switch and a grid-and-bar projection of the same
# model, for the audience that does not read logic diagrams; Print follows the active view.
# Read-only — editing stays in the TSLD by design. Frontend-only: it reads computed columns already
# on the wire, with no path back into the CPM engine. Set to "false" to roll back to the TSLD-only
# workspace (the flag-off parity suites pin that surface).
VITE_GANTT_VIEW=

# Tabbed activity editor (ADR-0060, docs/specs/activity-editor-restructure/). DEFAULT ON since
# 2026-07-29 (M6). One editor per activity, saving per write scope rather than per dialog — the
# scopes do not share a permission (definition writes need the pen, progress writes deliberately
# do not), so one merged Save would remove a Contributor's ability to report progress. Set to
# "false" to restore the separate Edit / Report-progress / Steps dialogs.

# Activity-editor convergence (ADR-0062, docs/specs/activity-editor-logic-resources-convergence/).
# DEFAULT ON since 2026-07-29. Folds the per-activity Logic and Resources pop-outs into tabs of the
# editor above, rendering the same panels the dialogs render so the two cannot drift. No permission
# change — the new scopes reuse the existing definition gate. Frontend-only. Set to "false" to send
# every entry point back to today's dialogs (the rollback path). It is AND-ed with
VITE_ACTIVITY_EDITOR_CONVERGENCE=

# The TSLD data-date line (canvas status & feedback M1, docs/specs/canvas-status-and-feedback/).
# OFF by default during build — flips on at that epic's M6 gate once the specialist reviews and the
# flag-on journey are green. Turns on the solid 2px data-date vertical + pill on the canvas
# (distinct from the dashed Today line by shape and weight, with a merged pill when the two
# coincide), its View▾ ▸ Markers toggle, the legend and export-legend entries, and the listbox's
# text statement of the data date. Frontend-only; no API/schema/engine change. Set to "true" to
# enable it; blank/"false" keeps the canvas paint, legend, export and a11y tree byte-for-byte.
VITE_CANVAS_DATA_DATE=

# TSLD search that navigates (docs/specs/canvas-search-navigation/).
# OFF by default during build — flips on at that epic's M5 gate once the specialist reviews and the
# flag-on journey are green. Turns the canvas search from a filter into a find control: Enter /
# Shift+Enter cycle the matches, each jump centres, selects and announces the bar, an n-of-m readout
# says where you are, and Zoom to selection frames what you landed on. DERIVED from
# VITE_CANVAS_LENSES — the search field is a lenses control, so this cannot be on without it.
# Frontend-only; no API/schema/engine change. Set to "true" to enable it; blank/"false" keeps the
# search field's filter-only behaviour, the toolbar and the a11y tree byte-for-byte.
VITE_CANVAS_SEARCH_NAV=

# TSLD canvas multi-select and bulk operations (docs/specs/canvas-multi-select/, ADR-0080).
# ON by default since 2026-08-08 (M5). Makes the canvas selection a SET: ctrl/cmd-click toggles, shift-click
# takes the bounding rectangle, a marquee sweeps, and a bulk bar moves, files or deletes the whole
# set in one all-or-nothing write and one undo step. DERIVED from VITE_CANVAS_DIRECT_MANIPULATION,
# because the legacy edge-drag reads Shift as the start-to-start chord and this epic gives Shift the
# span meaning — the two must never be live at once. Set to "false" to roll it back; that keeps the
# selection structurally singular and the canvas, toolbar and a11y tree byte-for-byte.
VITE_CANVAS_MULTI_SELECT=

# Activity copy, paste and duplicate (docs/specs/activity-copy-paste/).
# OFF by default during build — flips on at that epic's M5 gate. Adds Duplicate to the activities
# row menu and the canvas selection bar, Duplicate band for a WBS summary (the summary, its whole
# subtree and every dependency between the copied activities, in one confirmed action and one undo
# step), and Ctrl/Cmd+C / Ctrl/Cmd+V over a selected set. A copy carries the work's definition and
# not its history: no progress, no actuals, no notes, no inter-project commitments. Set to "true"
# to enable it; blank/"false" leaves the row menu, the selection bar and the keymap byte-for-byte.
VITE_ACTIVITY_COPY_PASTE=

# --- Self-hosted RELEASE stack (docker-compose.release.yml) — NOT app config ---
# These are consumed only by the release stack on a self-hosted host, not by the
# app at runtime. See docs/DEPLOYMENT.md. Leave unset for the compose defaults.
#
# Image tag per app (each defaults to `latest`; the two version independently — ADR-0027).
# Pin a version to roll back or hold a known release; `latest` tracks the newest.
# WEB_IMAGE_TAG=latest                  # or a version like 0.31.0
# API_IMAGE_TAG=latest                  # or a version like 0.18.0
# IMAGE_TAG=latest                      # shared override for BOTH (e.g. a branch build: main / sha-<short>)
#
# Optional automatic redeploy via Watchtower (ADR-0047), enabled only when the
# `autodeploy` compose profile is active:
#   COMPOSE_PROFILES=autodeploy docker compose -f docker-compose.release.yml up -d
# WATCHTOWER_POLL_INTERVAL=300          # seconds between GHCR checks
# WATCHTOWER_MONITOR_ONLY=false         # true = notify only, don't auto-update (a manual gate)
# WATCHTOWER_NOTIFICATION_URL=          # optional shoutrrr URL for release notifications
# DOCKER_CONFIG_DIR=/root/.docker       # ABSOLUTE path to the dir holding the `docker login ghcr.io` config.json (no ~)
