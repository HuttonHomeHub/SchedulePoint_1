{
  // Extended via a direct relative path (not the "@repo/config" package name):
  // Vite's rolldown transform does not resolve tsconfig `extends` through pnpm's
  // node_modules symlink, so the preset's own relative `extends` chain would
  // mis-resolve. tsc handles either form; this resolves on real paths for both.
  "extends": "../../packages/config/tsconfig/react.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    // The hand-run browser measurement (ADR-0065 T21). Included so it typechecks and lints
    // against the same painter it measures — a bench that drifts from the code is a fiction.
    "scripts",
    "e2e",
    "e2e-edit",
    "e2e-toolbar",
    "e2e-toolbar-fit",
    "measure-toolbar",
    "measure-gantt",
    "e2e-authoring",
    "e2e-authoring-flow",
    "e2e-programme",
    "e2e-notes",
    "e2e-undo",
    "e2e-loe",
    "e2e-resource-view",
    "e2e-interchange",
    "e2e-share",
    "e2e-library",
    "e2e-designed-ui",
    "e2e-designed-chrome",
    "e2e-gantt",
    "e2e-gantt-editing",
    "e2e-activity-editor",
    "e2e-wbs",
    "e2e-recently-deleted",
    "e2e-calendar-shifts",
    "e2e-sub-day",
    "e2e-assignment-lag",
    "e2e-float-paths",
    "e2e-search-nav",
    "e2e-audit",
    "e2e-account",
    "e2e-staff",
    "e2e-public",
    "e2e-overview",
    "e2e-csp",
    "e2e-multi-select",
    "e2e-copy-paste",
    "e2e-workspace-chrome",
    "e2e-minimap"
  ]
}
