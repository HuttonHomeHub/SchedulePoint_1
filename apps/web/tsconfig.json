{
  // Extended via a direct relative path (not the "@repo/config" package name):
  // Vite's rolldown transform does not resolve tsconfig `extends` through pnpm's
  // node_modules symlink, so the preset's own relative `extends` chain would
  // mis-resolve. tsc handles either form; this resolves on real paths for both.
  "extends": "../../packages/config/tsconfig/react.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    // The hand-run browser measurement (ADR-0065 T21). Included so it typechecks and lints
    // against the same painter it measures — a bench that drifts from the code is a fiction.
    "scripts",
    // **A glob, not a list.** This was 37 hand-maintained entries, and a suite left out of
    // it is silently NOT typechecked: `tsc --noEmit` simply never sees the files, and the
    // only thing that reports the omission is ESLint's parser refusing to resolve them —
    // an incidental catch by a gate aimed at something else. Adding `e2e-shell` produced
    // exactly that (2026-08-22): a clean typecheck over a journey the compiler had never
    // read. Derived is the repo's own rule for a roster (ADR-0093, ADR-0073 C4).
    //
    // `e2e-*/**/*` and NOT `e2e-*`: a wildcard SEGMENT makes TypeScript treat the pattern as a
    // file matcher rather than a directory to recurse into, so the bare form silently matched
    // nothing and the compiler read three suites instead of thirty-seven. Established with
    // `tsc --listFiles`, because the bare form typechecks perfectly happily — it just does it
    // over less.
    "e2e",
    "e2e-*/**/*",
    // Same rule, same reason: the measurement harnesses were two hand-maintained entries and
    // a third would have made it a roster again. Verified with `tsc --listFiles` that all
    // three `measure-*` directories are read.
    "measure-*/**/*"
  ]
}
