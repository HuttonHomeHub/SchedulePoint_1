{
  "name": "@repo/web",
  "version": "0.69.0",
  "private": true,
  "description": "SchedulePoint web client — React + Vite + Tailwind CSS, hand-rolled WAI-ARIA APG primitives.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:edit": "playwright test --config playwright.edit.config.ts --pass-with-no-tests",
    "test:e2e:workspace": "playwright test --config playwright.workspace.config.ts --pass-with-no-tests",
    "test:e2e:toolbar": "playwright test --config playwright.toolbar.config.ts --pass-with-no-tests",
    "test:e2e:authoring": "playwright test --config playwright.authoring.config.ts --pass-with-no-tests",
    "test:e2e:authoring-flow": "playwright test --config playwright.authoring-flow.config.ts --pass-with-no-tests",
    "test:e2e:programme": "playwright test --config playwright.programme.config.ts --pass-with-no-tests",
    "test:e2e:notes": "playwright test --config playwright.notes.config.ts --pass-with-no-tests",
    "test:e2e:undo": "playwright test --config playwright.undo.config.ts --pass-with-no-tests",
    "test:e2e:loe": "playwright test --config playwright.loe.config.ts --pass-with-no-tests",
    "test:e2e:resource-view": "playwright test --config playwright.resource-view.config.ts --pass-with-no-tests",
    "test:e2e:interchange": "playwright test --config playwright.interchange.config.ts --pass-with-no-tests",
    "test:e2e:share": "playwright test --config playwright.share.config.ts --pass-with-no-tests",
    "test:e2e:library": "playwright test --config playwright.library.config.ts --pass-with-no-tests",
    "test:e2e:calendar-shifts": "playwright test --config playwright.calendar-shifts.config.ts --pass-with-no-tests",
    "test:e2e:sub-day": "playwright test --config playwright.sub-day.config.ts --pass-with-no-tests",
    "test:e2e:assignment-lag": "playwright test --config playwright.assignment-lag.config.ts --pass-with-no-tests",
    "test:e2e:float-paths": "playwright test --config playwright.float-paths.config.ts --pass-with-no-tests",
    "measure:draw": "node scripts/measure-link-routing.mjs 120 scale --headed",
    "test:e2e:designed-ui": "playwright test --config playwright.designed-ui.config.ts --pass-with-no-tests",
    "test:e2e:designed-chrome": "playwright test --config playwright.designed-chrome.config.ts --pass-with-no-tests",
    "test:e2e:gantt": "playwright test --config playwright.gantt.config.ts --pass-with-no-tests",
    "test:e2e:activity-editor": "playwright test --config playwright.activity-editor.config.ts --pass-with-no-tests",
    "test:e2e:wbs": "playwright test --config playwright.wbs.config.ts --pass-with-no-tests",
    "test:e2e:audit": "playwright test --config playwright.audit.config.ts --pass-with-no-tests",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@repo/interchange": "workspace:*",
    "@repo/layout": "workspace:*",
    "@repo/types": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-virtual": "^3.14.8",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^3.0.0",
    "lucide-react": "^1.27.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.81.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "catalog:",
    "@repo/config": "workspace:*",
    "@repo/seed": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "catalog:",
    "vite": "^8.1.4",
    "vitest": "catalog:",
    "vitest-axe": "^0.1.0"
  }
}
