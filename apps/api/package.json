{
  "name": "@repo/api",
  "version": "0.34.0",
  "private": true,
  "description": "SchedulePoint REST API \u2014 NestJS + Prisma + PostgreSQL, documented with OpenAPI.",
  "license": "MIT",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:pairwise": "vitest run --config vitest.pairwise.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:check-drift": "prisma migrate diff --from-url \"$DATABASE_URL\" --to-schema-datamodel ./prisma/schema.prisma --exit-code",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.2.1",
    "@repo/interchange": "workspace:*",
    "@repo/layout": "workspace:*",
    "@repo/types": "workspace:*",
    "better-auth": "^1.6.25",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "5.2.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.3.0",
    "pino-http": "^11.0.0",
    "prisma": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@repo/config": "workspace:*",
    "@repo/engine-conformance": "workspace:*",
    "@repo/seed": "workspace:*",
    "@repo/seed-http": "workspace:*",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "^1.5.1",
    "vitest": "catalog:"
  }
}
