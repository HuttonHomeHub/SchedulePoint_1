{
  "name": "@repo/api",
  "version": "0.87.1",
  "private": true,
  "description": "SchedulePoint REST API — NestJS + Prisma + PostgreSQL, documented with OpenAPI.",
  "license": "MIT",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint . --cache --cache-strategy content --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:e2e:pairwise": "vitest run --config vitest.pairwise.config.mts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:check-drift": "prisma migrate diff --from-url \"$DATABASE_URL\" --to-schema-datamodel ./prisma/schema.prisma --exit-code",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.2.1",
    "@repo/interchange": "workspace:*",
    "@repo/layout": "workspace:*",
    "@repo/types": "workspace:*",
    "better-auth": "^1.7.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "5.2.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.2.1",
    "nodemailer": "^10.0.10",
    "pino-http": "^11.0.0",
    "prisma": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@repo/config": "workspace:*",
    "@repo/engine-conformance": "workspace:*",
    "@repo/seed": "workspace:*",
    "@repo/seed-http": "workspace:*",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
