{
  "name": "@repo/seed-cli",
  "version": "0.0.1",
  "private": true,
  "description": "Seeds the SchedulePoint test catalogue into a RUNNING instance over the public REST API (ADR-0066). Never touches the database directly.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "schedulepoint-seed": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx src/main.ts",
    "clean": "rimraf dist .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@repo/seed": "workspace:*",
    "zod": "^4.0.0",
    "@repo/seed-http": "workspace:*"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@repo/engine-conformance": "workspace:*",
    "@types/node": "^22.10.7",
    "eslint": "^9.39.5",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
