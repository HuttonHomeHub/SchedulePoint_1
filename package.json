{
  "name": "schedulepoint",
  "version": "0.1.0",
  "private": true,
  "description": "SchedulePoint — browser-based construction scheduling built around a Time-Scaled Logic Diagram.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "typecheck": "turbo run typecheck",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:playbook": "node scripts/check-playbook.mjs",
    "check:build-contract": "node scripts/check-build-contract.mjs",
    "check:surface-contract": "node scripts/check-surface-contract.mjs",
    "check:flags": "node scripts/check-flags.mjs",
    "check:counts": "node scripts/check-counts.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:adr-coverage": "node scripts/check-adr-coverage.mjs",
    "check:nginx": "node scripts/check-nginx-template.mjs",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "prepare": "husky",
    "commit": "cz",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "check:frontend-only": "node scripts/check-frontend-only.mjs",
    "prepush": "bash scripts/prepush.sh"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.0.1",
    "turbo": "^2.10.9",
    "typescript": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma"
    ]
  }
}
